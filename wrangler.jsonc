{
  // Cloudflare 的 Workers Builds 用 wrangler 部署，它会自己探测 Next.js 项目。
  // 这个文件把探测结果固定下来，免得以后 wrangler 换了默认值又出意外。
  //
  // 注意：项目建的是 **Worker**（新流程），不是经典 Pages。
  // 所以构建命令走 `npm run build`（普通 next build），由 wrangler 负责适配，
  // 不需要 @cloudflare/next-on-pages —— 那个是经典 Pages 流程的产物。
  "name": "zju-ecaiclub",
  "compatibility_date": "2026-07-31",
  // 边缘运行时要跑 Next 的服务端代码，必须开 Node 兼容
  "compatibility_flags": ["nodejs_compat"]
}
