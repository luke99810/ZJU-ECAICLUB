# 复制为 .env.local 后填写。.env.local 已被 gitignore，不会提交。

# ── AI 能力（现在就能用）─────────────────────────────────────────────
# 任选一家免费开放的 OpenAI 兼容接口，填 key 即可。不填的话 AI 工具页会显示
# 「尚未接入」的引导，其余功能不受影响。
#
#   硅基流动   https://api.siliconflow.cn/v1     （默认，注册即有免费额度）
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1
#   豆包       https://ark.cn-beijing.volces.com/api/v3
AI_API_KEY=
AI_API_BASE=https://api.siliconflow.cn/v1
AI_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── Supabase（尚未接入，占位）────────────────────────────────────────
# 开通后填这两个，并把 src/lib/store.ts / src/lib/auth.ts 的实现换成 supabase-js。
# 建表 SQL 见 supabase/schema.sql。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
